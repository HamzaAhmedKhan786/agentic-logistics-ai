    {
      "type": "timeseries",
      "title": "Workflow latency",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(logistics_plan_duration_seconds_bucket[5m])) by (le))", "refId": "A"}],
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0}
    },
    {
      "type": "stat",
      "title": "Active traffic monitors",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "logistics_active_traffic_monitors", "refId": "A"}],
