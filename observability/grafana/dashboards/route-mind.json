    },
    {
      "type": "timeseries",
      "title": "Replans by reason",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (reason) (rate(logistics_replans_total[5m]))", "refId": "A"}],
