###################################
# APPLICATION
###################################

APP_NAME=Agentic Logistics AI
APP_ENV=development

###################################
# LLM
###################################

# LLM provider: mock, groq, or openai
# Create a new Groq key and place it only in your local .env file.
# Never commit or share the real key.
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=

# Optional OpenAI configuration
OPENAI_API_KEY=

###################################
# MAPS AND TRAFFIC
###################################

# Free-map mode needs no HERE/Google account:
# OpenFreeMap + MapLibre render the basemap, while simulated mode supplies
# stable demo coordinates and approximate routes.
LOCATION_PROVIDER=simulated
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org
TRAFFIC_PROVIDER=synthetic

# Optional managed providers. Set both LOCATION_PROVIDER and ROUTING_PROVIDER
# to `here` or `google` when selecting one.
HERE_API_KEY=
GOOGLE_MAPS_API_KEY=

# Tavily is optional. It is only needed for live disruption/news research,
# not for geocoding or road routing.
TAVILY_API_KEY=
TAVILY_ENABLED=true
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=8
DISRUPTION_CONFIDENCE_THRESHOLD=0.75

# No-key current Berlin weather from Open-Meteo.
WEATHER_ENABLED=true
WEATHER_LATITUDE=52.52
WEATHER_LONGITUDE=13.405
SEVERE_WIND_GUST_KMH=70

###################################
# OPTIMIZATION
###################################

USE_ORTOOLS=true

###################################
# POSTGRESQL
###################################

# Run .\database\scripts\setup.ps1 and replace this with the URL it prints.
# URL-encode special password characters; for example, + becomes %2B.
DATABASE_URL=postgresql+asyncpg://logistics:replace-with-url-encoded-password@localhost:5432/logistics

# SQLite fallback if PostgreSQL is temporarily unavailable:
# DATABASE_URL=sqlite+aiosqlite:///./output/logistics.db

###################################
# WORKFLOW
###################################

TRAFFIC_POLL_SECONDS=60
MAX_REPLANS=2
REQUEST_TIMEOUT_SECONDS=20

###################################
# OBSERVABILITY AND EVALUATION
###################################

LOG_LEVEL=INFO
PROMETHEUS_PUSHGATEWAY=http://localhost:9091

# Enable only when intentionally running Groq-backed DeepEval tests.
RUN_LLM_EVALS=false
